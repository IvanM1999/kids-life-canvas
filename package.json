{
  "name": "kids-life-canvas",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "apps/*"
  ],
  "type": "module",
  "description": "Local-first, offline-capable digital canvas for tracking and documenting children's lives",
  "scripts": {
    "dev": "npm run dev --workspace apps/web",
    "build": "npm run build --workspace apps/web",
    "preview": "npm run preview --workspace apps/web",
    "start": "npm run preview --workspace apps/web -- --host 0.0.0.0 --port ${PORT:-4173}"
  },
  "keywords": [
    "family",
    "memories",
    "local-first",
    "offline",
    "children",
    "timeline",
    "album"
  ],
  "author": "Ivan Montibeller",
  "license": "MIT"
}
